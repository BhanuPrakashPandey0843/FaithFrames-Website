rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// FaithFrames Firestore Security Rules
// Project : wallpaper-c74a3
//
// Architecture overview
// ─────────────────────
// • Admin writes  → Next.js API routes (/api/admin/*) using the Admin SDK.
//                   Admin SDK calls bypass these rules entirely.
// • Admin reads   → Next.js API routes (/api/admin/collection/*) — also Admin SDK.
//                   Client-side components fetch from the API, not directly from
//                   Firestore, so no client-SDK admin reads are needed.
// • Mobile / public reads → Firebase client SDK with Firebase Auth.
//                   Only authenticated app users read content collections.
// • Public (unauthenticated) reads → denied for all collections.
//
// Rule summary
// ────────────
// religiousWallpapers  : authenticated read   | no client write
// dailyVerses          : authenticated read   | no client write
// dailyPrayers         : authenticated read   | no client write
// questions            : authenticated read   | no client write
// stories              : authenticated read   | no client write
// featuredStories      : authenticated read   | no client write
// witnessPosts         : authenticated read   | no client write
// meetSessions         : authenticated read   | no client write
// witnessCarousel      : authenticated read   | no client write
// witnessVideos        : authenticated read   | no client write (+/-1 counter nudge)
// bibleContent         : authenticated read   | no client write (+/-1 counter nudge)
// jesusContent         : authenticated read   | no client write (+/-1 counter nudge)
// prayersContent       : authenticated read   | no client write (+/-1 counter nudge)
// worshipContent       : authenticated read   | no client write (+/-1 counter nudge)
// bibleCarousel        : authenticated read   | no client write
// jesusCarousel        : authenticated read   | no client write
// prayersCarousel      : authenticated read   | no client write
// worshipCarousel      : authenticated read   | no client write
// users                : owner read/write     | no other client access
// wallpaper_preferences: owner read/write     | no other client access
// premiumUsers         : owner read           | no client write
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    // True when the caller has a valid Firebase Auth token
    function isAuthenticated() {
      return request.auth != null;
    }

    // True when the caller's uid matches the document owner field
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Public / app content collections ───────────────────────────────────
    // Mobile app users (authenticated) can read these.
    // All writes come exclusively through the Admin SDK (API routes) —
    // client writes are therefore denied here.

    // Religious wallpapers shown in the mobile app
    match /religiousWallpapers/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // Daily verse of the day
    match /dailyVerses/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // Daily prayers
    match /dailyPrayers/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // Quiz questions
    match /questions/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // Inspirational quotes (Library > Quotes tab)
    match /quotes/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // Regular prophet stories
    match /stories/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // Featured prophet stories (separate collection from regular stories)
    match /featuredStories/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // Witness / testimony posts
    match /witnessPosts/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // Meet & share sessions
    match /meetSessions/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only

      // Live Worship Room RSVPs — one doc per user, keyed by uid.
      // Read is authenticated (matches parent) so the app can show
      // real-time going/not-going counts; write is restricted to the
      // owning user and validated to a fixed shape.
      match /rsvps/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(uid)
          && request.resource.data.response in ['going', 'not_going']
          && request.resource.data.keys().hasOnly(['response', 'updatedAt']);
        allow delete: if false;
      }
    }

    // God's words / quotes collection
    match /godsWords/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // Study plans collection
    match /studyPlans/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // ── Bible tab CMS (reading plans, daily verses, banners, announcements) ──
    // Mirrors src/constants COLLECTIONS.BIBLE_* used by BiblePlansScreen /
    // BibleHomeScreen — admin-controlled, read-only for the app.
    match /bibleReadingPlans/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }
    match /bibleDailyVerses/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }
    match /bibleBanners/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }
    match /bibleAnnouncements/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // ── Witness Videos module ────────────────────────────────────────────────
    // Hero carousel banners — fully admin-controlled, read-only for the app.
    match /witnessCarousel/{bannerId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // Witness video catalogue. Full document CRUD (title, video, thumbnail,
    // etc.) is Admin SDK only. A narrow exception lets authenticated users
    // nudge the "views"/"likes"/"dislikes" counters by at most 1 per write —
    // this keeps the mobile app's real-time counts free (they ride along on
    // the existing list listener) without exposing full write access.
    match /witnessVideos/{videoId} {
      allow read: if isAuthenticated();
      allow write: if false;

      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes', 'dislikes', 'updatedAt'])
        && request.resource.data.views is number
        && request.resource.data.likes is number
        && request.resource.data.dislikes is number
        && (request.resource.data.views - resource.data.views) in [-1, 0, 1]
        && (request.resource.data.likes - resource.data.likes) in [-1, 0, 1]
        && (request.resource.data.dislikes - resource.data.dislikes) in [-1, 0, 1];

      // One doc per user: tracks whether *this* user has liked / disliked /
      // already counted a view for this video. Mutually exclusive like+dislike
      // is enforced here, not just client-side.
      match /userInteractions/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['liked', 'disliked', 'viewed', 'updatedAt'])
          && request.resource.data.liked is bool
          && request.resource.data.disliked is bool
          && request.resource.data.viewed is bool
          && !(request.resource.data.liked == true && request.resource.data.disliked == true);
        allow delete: if false;
      }
    }

    // ── Explore Faith module (Bible / Jesus / Prayers / Worship) ──────────────
    // Same shape as the Witness Videos module above: full document CRUD is
    // Admin SDK only, with a narrow exception letting authenticated users
    // nudge views/likes/dislikes by at most 1 per write (mirrored client-side
    // by a Firestore transaction), plus a per-user interaction doc that
    // records what *this* user has liked/disliked/viewed so those nudges stay
    // idempotent and mutually exclusive.
    function isContentCounterUpdate() {
      return isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes', 'dislikes', 'updatedAt'])
        && request.resource.data.views is number
        && request.resource.data.likes is number
        && request.resource.data.dislikes is number
        && (request.resource.data.views - resource.data.views) in [-1, 0, 1]
        && (request.resource.data.likes - resource.data.likes) in [-1, 0, 1]
        && (request.resource.data.dislikes - resource.data.dislikes) in [-1, 0, 1];
    }

    function isValidUserInteractionWrite(uid) {
      return isOwner(uid)
        && request.resource.data.keys().hasOnly(['liked', 'disliked', 'viewed', 'updatedAt'])
        && request.resource.data.liked is bool
        && request.resource.data.disliked is bool
        && request.resource.data.viewed is bool
        && !(request.resource.data.liked == true && request.resource.data.disliked == true);
    }

    match /bibleContent/{contentId} {
      allow read: if isAuthenticated();
      allow write: if false;
      allow update: if isContentCounterUpdate();

      match /userInteractions/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isValidUserInteractionWrite(uid);
        allow delete: if false;
      }
    }
    match /jesusContent/{contentId} {
      allow read: if isAuthenticated();
      allow write: if false;
      allow update: if isContentCounterUpdate();

      match /userInteractions/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isValidUserInteractionWrite(uid);
        allow delete: if false;
      }
    }
    match /prayersContent/{contentId} {
      allow read: if isAuthenticated();
      allow write: if false;
      allow update: if isContentCounterUpdate();

      match /userInteractions/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isValidUserInteractionWrite(uid);
        allow delete: if false;
      }
    }
    match /worshipContent/{contentId} {
      allow read: if isAuthenticated();
      allow write: if false;
      allow update: if isContentCounterUpdate();

      match /userInteractions/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isValidUserInteractionWrite(uid);
        allow delete: if false;
      }
    }

    // Hero carousels — fully admin-controlled, read-only for the app.
    match /bibleCarousel/{bannerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /jesusCarousel/{bannerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /prayersCarousel/{bannerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /worshipCarousel/{bannerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── User profile collection ─────────────────────────────────────────────
    // Each user may read and update only their own document.
    // Admins read all user documents via the Admin SDK (stats, premium-users API).
    match /users/{userId} {
      allow read:   if isOwner(userId);
      allow update: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // only Admin SDK may delete user records

      match /attemptedQuestions/{questionId} {
        allow read, write: if isOwner(userId);
      }
      match /quizSessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.status == 'completed'
          && request.resource.data.sessionId == sessionId;
        allow update, delete: if false;
      }
      match /favorites/{wallpaperId} {
        allow read, write: if isOwner(userId);
      }
      match /bookmarks/{storyId} {
        allow read, write: if isOwner(userId);
      }
      match /savedVideos/{videoId} {
        allow read, write: if isOwner(userId);
      }
      match /likedVideos/{videoId} {
        allow read, write: if isOwner(userId);
      }
      match /dislikedVideos/{videoId} {
        allow read, write: if isOwner(userId);
      }
      match /savedBibleContent/{contentId} {
        allow read, write: if isOwner(userId);
      }
      match /savedJesusContent/{contentId} {
        allow read, write: if isOwner(userId);
      }
      match /savedPrayersContent/{contentId} {
        allow read, write: if isOwner(userId);
      }
      match /savedWorshipContent/{contentId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Wallpaper preferences (mobile: Settings → Wallpaper Settings) ───────
    // One document per user, keyed by uid — same ownership model as
    // /users/{userId} above. This collection previously had no match block, so
    // the catch-all deny at the bottom of this file rejected every read and
    // write from the Wallpaper Settings screen with "Missing or insufficient
    // permissions". Shape is validated so the document can only ever hold the
    // five preference fields the screen actually writes.
    match /wallpaper_preferences/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'categories', 'quality', 'downloadPreference',
          'autoWallpaper', 'smartRecommendations'
        ])
        && (!('categories' in request.resource.data) || request.resource.data.categories is map)
        && (!('quality' in request.resource.data) || request.resource.data.quality is string)
        && (!('downloadPreference' in request.resource.data) || request.resource.data.downloadPreference is string)
        && (!('autoWallpaper' in request.resource.data) || request.resource.data.autoWallpaper is string)
        && (!('smartRecommendations' in request.resource.data) || request.resource.data.smartRecommendations is bool);
      allow delete: if false;
    }

    // ── User-submitted prayers (Write a Prayer + Community Prayer Requests) ──
    // Users create their own prayers (status always starts 'pending'); admin
    // moderation (approve/reject/delete) happens exclusively through the
    // /api/admin/user-prayers Admin SDK route, which bypasses these rules.
    // Once a submission is approved it also becomes readable by every
    // authenticated user, since it now appears in the Prayer Room's
    // Community Prayer Requests section.
    function priorPrayCount() {
      return ('prayCount' in resource.data) ? resource.data.prayCount : 0;
    }
    function priorCommentCount() {
      return ('commentCount' in resource.data) ? resource.data.commentCount : 0;
    }
    // Narrow exception letting any authenticated user nudge prayCount by
    // ±1 ("I'm Praying") or commentCount by +1 (new comment) on an approved
    // request only — mirrors isContentCounterUpdate() above exactly.
    function isPrayerEngagementUpdate() {
      return isAuthenticated()
        && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayCount', 'commentCount', 'updatedAt'])
        && request.resource.data.prayCount is number
        && request.resource.data.commentCount is number
        && (request.resource.data.prayCount - priorPrayCount()) in [-1, 0, 1]
        && (request.resource.data.commentCount - priorCommentCount()) in [0, 1];
    }

    match /userPrayers/{prayerId} {
      // A user may always read their own submissions (mobile "My Prayers"
      // status view, incl. pending/rejected). Any authenticated user may
      // read a request once it's approved (Community Prayer Requests).
      allow read: if isOwner(resource.data.userId) || (isAuthenticated() && resource.data.status == 'approved');

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0;

      // Status changes (approve/reject) stay admin-only, via Admin SDK.
      // The one client-writable path is the narrow engagement-counter nudge.
      allow update: if isPrayerEngagementUpdate();

      // A user may delete only their own, still-pending submission.
      allow delete: if isOwner(resource.data.userId);

      // One doc per user: has this user tapped "I'm Praying" for this request?
      match /prayingUsers/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['praying', 'updatedAt'])
          && request.resource.data.praying is bool;
        allow delete: if false;
      }

      // Encouraging comments on an approved request. Immutable once posted
      // (no edit/delete) to keep the commentCount counter always accurate.
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.keys().hasOnly(['userId', 'username', 'text', 'createdAt']);
        allow update, delete: if false;
      }
    }

    // ── Quiz leaderboards ───────────────────────────────────────────────────
    // leaderboards/{boardId}/entries/{entryId} — entryId is the submitting
    // user's uid. Read is authenticated (leaderboard screen); writes are
    // restricted to the owning user and validated to a safe score/accuracy
    // range. Mirrors src/services/quizService.js + QUIZ_COLLECTIONS.LEADERBOARDS.
    match /leaderboards/{boardId}/entries/{entryId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(entryId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 50000
        && request.resource.data.accuracy is number
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100;
      allow delete: if false;
    }

    // ── Premium users / subscriptions ──────────────────────────────────────
    // The mobile app may read the calling user's own premium record.
    // The admin panel reads all records via the Admin SDK (API route).
    match /premiumUsers/{userId} {
      allow read:  if isOwner(userId);
      allow write: if false; // Admin SDK only (set by payment webhooks)
    }

    // ── Deny everything else ───────────────────────────────────────────────
    // Explicit catch-all: any collection not listed above is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
