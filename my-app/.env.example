# ── Firebase Client (public) ───────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ── Cloudinary ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Firebase Admin (server-only) ───────────────────────────────────────────────
# Paste your full service account JSON on a single line
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── Admin Credentials (server-only) ───────────────────────────────────────────
# Login credentials for the admin panel
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_SESSION_SECRET=generate_strong_secret_with_node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── Push notifications (server-only) ──────────────────────────────────────────
# REQUIRED for admin broadcasts to be delivered. The Netlify scheduled function
# (netlify/functions/notifications-worker.mjs) calls /api/cron/notifications every
# minute with this secret; without it campaigns stay "Queued" forever.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_CRON_SECRET=generate_a_long_random_secret
# Optional: Expo access token (https://expo.dev/accounts/[account]/settings/access-tokens).
# Required only if "Enhanced Push Security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=
# Optional: milliseconds one worker run may spend starting new batches (default 7000,
# sized for a 10 s serverless limit). Raise it if your host allows longer functions.
# NOTIFICATION_TICK_BUDGET_MS=7000

# ── Payment Gateways (optional) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
